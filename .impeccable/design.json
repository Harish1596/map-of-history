      "css": ".ds-button{font-family:\"Noto Sans\",sans-serif;color:var(--ink,#283b42);width:44px;height:44px;display:grid;place-items:center;padding:0;background:var(--paper,#ffffff);border:0;cursor:pointer;transition:background-color 120ms ease-out;}.ds-reset{width:46px;height:46px;border:1px solid var(--line,#6b8184);border-radius:3px}.ds-button:hover:not(:disabled){background:#e4eded}.ds-button:active:not(:disabled){background:#d4e0df}.ds-button:focus-visible{outline:3px solid var(--focus,#175c6f);outline-offset:3px;}.ds-button:disabled{color:#8a979b;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:0ms}}"
