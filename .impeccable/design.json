  "narrative": {
    "northStar": "The Classroom World Map",
    "overview": "A light, quiet geographic canvas supports students and educators on shared classroom screens. Muted sage land, pale ocean, distinct borders and plain country names carry the visual identity. Small white controls remain subordinate to geography.\n\nThe approved world replaces the former dark, gold, serif siege interface. The visual language favors clarity and geographic context; runtime geography and font assets are local.",
    "keyCharacteristics": [
      "Sage land against a pale blue-gray ocean.",
      "Plain sans-serif labels and distinct slate boundaries.",
      "Small white rectangular controls with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Geographic Color Rule",
        "body": "Keep land, ocean and boundary colors consistent between the CSS interface and the MapLibre style.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal contrast for separation; keep control surfaces unshadowed.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use local Noto Sans for both interface text and map labels.",
      "Do preserve visible borders, keyboard focus and generous navigation hit areas.",
      "Do let country labels reveal through zoom and collision placement.",
      "Do retain the source and boundary-convention disclosure."
    ],
    "donts": [
      "Don't revive the former dark, gold, serif siege visual language.",
      "Don't add ornamental shadows or decorative display typography.",
      "Don't treat illustrative mock geography as authoritative map geometry."
    ]
  }
